{
  "name": "waveforge",
  "productName": "WaveForge 澜音工坊",
  "version": "0.1.4",
  "description": "沉浸式音乐播放器，支持网易云和QQ音乐",
  "author": "WaveForge",
  "type": "module",
  "main": "desktop/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "node dev-tv-server.mjs",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build": "vite build",
    "build:electron": "npm run build && electron-builder --win nsis --publish never",
    "build:electron:dir": "npm run build && electron-builder --win dir --publish never",
    "bundle-python": "node scripts/bundle-python.mjs",
    "build:full": "npm run bundle-python && npm run build:electron",
    "start": "electron .",
    "preview": "vite preview",
    "fetch:nodejs-mobile": "node scripts/fetch-nodejs-mobile.mjs",
    "prebuild:android": "node scripts/sync-afdian-sponsors.mjs --optional",
    "postinstall": "node scripts/patch-airplay-chacha.cjs || true",
    "build:android": "node scripts/build-android-assets.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "sync:sponsors": "node scripts/sync-afdian-sponsors.mjs",
    "prebuild": "node scripts/build-v3-worklet.mjs && node scripts/sync-afdian-sponsors.mjs --optional",
    "test:license": "node scripts/test-device-license.cjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "version:pre": "node scripts/bump-version.mjs pre",
    "version:dry": "node scripts/bump-version.mjs --dry-run",
    "build:v3-worklet": "node scripts/build-v3-worklet.mjs",
    "predev": "node scripts/build-v3-worklet.mjs",
    "predev:electron": "node scripts/build-v3-worklet.mjs"
  },
  "build": {
    "appId": "com.waveforge.desktop",
    "productName": "WaveForge 澜音工坊",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "server/**/*",
      "python-beat-service/**/*",
      "!python-beat-service/packages/**/*",
      "local-server.mjs",
      "requirements.txt",
      "install-python-deps.bat",
      "package.json",
      "logo.png",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/python-embed",
        "to": "python-embed",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/python-embed/**/*",
      "desktop/workers/**/*.py",
      "server/**/*.py",
      "python-beat-service/**/*.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "executableName": "WaveForge 澜音工坊",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "WaveForge 澜音工坊",
      "artifactName": "WaveForge-${version}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@jixun/qmweb-sign": "^2.0.3",
    "@lox-audioserver/node-airplay-sender": "^0.4.10",
    "@neteasecloudmusicapienhanced/api": "^4.39.0",
    "@noble/ciphers": "^1.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@soundtouchjs/audio-worklet": "^2.1.1",
    "@svg-maps/world": "^2.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.0.4",
    "bonjour-service": "^1.4.4",
    "china-area-data": "^5.0.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "framer-motion": "^12.40.0",
    "h5wasm": "^0.10.3",
    "jsmediatags": "^3.9.7",
    "lamejs": "^1.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "opencc-js": "^1.0.5",
    "qq-music-api": "^1.1.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-window": "^2.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/jsmediatags": "^3.9.6",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.184.1",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qq-music-api": {
      "axios": "^1.19.0",
      "express": "^4.22.2",
      "morgan": "^1.11.0",
      "xml2js": "^0.6.2",
      "jade": {
        "clean-css": "^4.1.11",
        "constantinople": "^3.1.2",
        "transformers": {
          "uglify-js": "^2.8.29"
        }
      },
      "useragent": {
        "tmp": "^0.2.7"
      }
    }
  }
}
